# Copia este archivo como .env y completa los valores.

# Clave de la API de Anthropic (Claude). Si está vacía, todo funciona en modo simulado.
ANTHROPIC_API_KEY=

# Modelo y nivel de esfuerzo de la IA
IA_MODELO=claude-opus-5-5
IA_ESFUERZO=low

# Nombre que aparece en la plataforma y en los documentos
NOMBRE_PLANTA=Central Renovable

# true = el modo práctica también usa la IA real (con los datos ficticios)
PRACTICA_USA_IA=false

# Orígenes permitidos (frontend)
CORS_ORIGINS=http://localhost:3000

# true = carga una semana de datos ficticios en las gráficas (práctica y real) la primera vez
SEMBRAR_DATOS=true
